# ── Supabase (wajib) ──────────────────────────────────────────────
# Hanya dipakai untuk Realtime (Broadcast + Presence). Tidak perlu membuat tabel apa pun.
# Ambil di Supabase Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Project lama yang masih memakai anon key juga bisa:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── TURN server (sangat disarankan untuk jaringan seluler) ────────
# Pilih SALAH SATU cara di bawah. Variabel ini hanya dibaca di server (/api/ice).

# Cara 1: endpoint yang mengembalikan array iceServers, mis. Metered.ca:
# TURN_CREDENTIALS_URL=https://NAMA-APP.metered.live/api/v1/turn/credentials?apiKey=API_KEY

# Cara 2: kredensial statis (pisahkan beberapa URL dengan koma):
# TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
